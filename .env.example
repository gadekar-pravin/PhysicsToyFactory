PTF_HOST=127.0.0.1
PTF_PORT=8120
PTF_S17_BASE_URL=http://127.0.0.1:8113
PTF_S17_CONTROL_TOKEN=replace-with-the-private-s17-control-token
PTF_S17_RUN_BUDGET_USD=0.50
PTF_WORKSPACE=/absolute/path/to/PhysicsToyFactory/.runtime/workspace
PTF_ARTIFACT_DIR=/absolute/path/to/PhysicsToyFactory/.runtime/artifacts
PTF_MAX_PROMPT_CHARS=4000
PTF_HTTP_CONNECT_TIMEOUT_SECONDS=3
PTF_HTTP_READ_TIMEOUT_SECONDS=30
PTF_PREVIEW_READY_TIMEOUT_SECONDS=8
PTF_MAX_SKETCH_BYTES=100000
S17_EXEC_CONTAINER=0
S17_EXEC_IMAGE=replace-with-a-pinned-non-root-node-image
