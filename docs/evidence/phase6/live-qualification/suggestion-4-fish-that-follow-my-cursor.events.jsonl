{"data": {"delta": {"op": "add", "path": "/results/read_sketch_js_for_edit", "value": {"budget_decisions": [], "end_line": 45, "metered_calls": [], "path": "sketch.js", "start_line": 1, "text": "     1  let fish;\n     2  \n     3  function setup() {\n     4    createCanvas(400, 400);\n     5    fish = new Fish();\n     6  }\n     7  \n     8  function draw() {\n     9    background(220);\n    10    fish.update();\n    11    fish.display();\n    12  }\n    13  \n    14  class Fish {\n    15    constructor() {\n    16      this.x = width / 2;\n    17      this.y = height / 2;\n    18      this.speed = 5;\n    19    }\n    20  \n    21    update() {\n    22      let targetX = mouseX;\n    23      let targetY = mouseY;\n    24  \n    25      let dx = targetX - this.x;\n    26      let dy = targetY - this.y;\n    27      let distance = dist(this.x, this.y, targetX, targetY);\n    28  \n    29      if (distance > 1) {\n    30        this.x += (dx / distance) * this.speed;\n    31        this.y += (dy / distance) * this.speed;\n    32      }\n    33    }\n    34  \n    35    display() {\n    36      fill(0, 191, 255); // Blue color for fish\n    37      noStroke();\n    38      ellipse(this.x, this.y, 40, 20); // Fish body\n    39      triangle(\n    40        this.x - 20, this.y,\n    41        this.x - 30, this.y - 10,\n    42        this.x - 30, this.y + 10\n    43      ); // Fish tail\n    44    }\n    45  }", "total_lines": 45, "truncated": false}}, "seq": 22, "source_kind": "task_succeeded", "stepName": "read_sketch_js_for_edit", "type": "STEP_FINISHED"}, "id": "22"}
